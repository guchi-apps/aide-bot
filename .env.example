# アプリ実行時に参照する環境変数（値は空。ローカル開発の記入例は .env.local.example を参照）

# MariaDB接続。本番は DB_* から scripts/construct-database-url.sh が組み立てる
DATABASE_URL=

# Supabase Auth（他アプリと共有のSupabaseプロジェクト）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 利用を許可するGoogleアカウント（カンマ区切り）。未設定の場合は全員ログイン不可
ALLOWED_GOOGLE_EMAILS=

# チャットの返答生成に使うClaude APIのキー（1Password: apps/aide-bot/anthropic-api-key）
ANTHROPIC_API_KEY=

# デプロイ時のみ使用（DATABASE_URL の組み立て元。scripts/construct-database-url.sh）
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
DB_NAME=

# CI/デプロイ通知
SIGNALY_WEBHOOK_URL=

# 秘書からのプロアクティブ通知（#79）。Web PushのVAPID鍵のペア。
# 片方でも空だと、設定の画面に通知の導線そのものが出ない。
# 作り方: node -e 'console.log(JSON.stringify(require("web-push").generateVAPIDKeys()))'
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# cronが POST /api/briefing を叩くときの共有シークレット。空なら経路ごと閉じる
BRIEFING_TRIGGER_TOKEN=
