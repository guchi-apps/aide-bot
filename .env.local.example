# ローカル開発用。`pnpm env:init` で .env.local としてコピーしてから編集する。
# .env.local はgit管理外。実シークレットはここと1Passwordにのみ置く。

# ローカルのMariaDB/MySQL。pnpm db:setup がこのURLからDB・ユーザーを作成する
DATABASE_URL="mysql://aide_bot:aide_bot@127.0.0.1:3306/app_aide_bot"

# Supabase Auth（他アプリと共有のSupabaseプロジェクト。1Password: apps/Supabase）
# Redirect URLs に http://localhost:3000/auth/callback の登録が必要
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# 自分のGoogleアカウントのメールアドレス（カンマ区切りで複数可）
ALLOWED_GOOGLE_EMAILS=""

# チャットの返答生成に使うClaude APIのキー（1Password: apps/aide-bot/anthropic-api-key）
# 未設定でも画面は開くが、送信するとサーバー側の設定不足として弾かれる
ANTHROPIC_API_KEY=""

# 秘書からのプロアクティブ通知（#79）。Web PushのVAPID鍵のペア。
# **手元で使う鍵は自分で作る**（1Passwordの本番の鍵は持ち出さない）。
#   node -e 'console.log(JSON.stringify(require("web-push").generateVAPIDKeys()))'
# 片方でも空だと、設定の画面に通知の導線そのものが出ない。
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# cronが POST /api/briefing を叩くときの共有シークレット。空ならこの経路は401で閉じる。
# 手元で朝の見通しを試すときだけ、適当な値を入れて curl の Bearer に同じ値を使う。
BRIEFING_TRIGGER_TOKEN=""

# 他アプリが POST /api/notices でお知らせを積むときの共有シークレット（#93）。
# 空ならこの経路は401で閉じる。手元で吹き出しを試すときだけ、適当な値を入れて
# curl の Bearer に同じ値を使う。
NOTICE_INGEST_TOKEN=""

# ChatGPTのスケジュールから接続するMCPエンドポイントは /api/mcp

# 開発サーバーのポート（省略時は3000）
# PORT=3000

# 開発用ログイン（Cookieバイパス）のシークレット。設定されている開発環境でのみ、
# ログイン画面に「開発用ダミーユーザーでログイン」ボタンが出る。
# `pnpm db:seed:dev` が未設定なら自動生成して書き足すので、通常は手で書かなくてよい。
# **本番には絶対に設定しない**（NODE_ENV=production では無効化されるが、二重に塞ぐため）。
# CI_LOGIN_BYPASS_SECRET=""
