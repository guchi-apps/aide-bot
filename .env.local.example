# ローカル開発用。`pnpm env:init` で .env.local としてコピーしてから編集する。
# .env.local はgit管理外。実シークレットはここと1Passwordにのみ置く。

# ローカルのMariaDB/MySQL。pnpm db:setup がこのURLからDB・ユーザーを作成する
DATABASE_URL="mysql://aide_bot:aide_bot@127.0.0.1:3306/app_aide_bot"

# Supabase Auth（他アプリと共有のSupabaseプロジェクト。1Password: apps/Supabase）
# Redirect URLs に http://localhost:3000/auth/callback の登録が必要
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# 自分のGoogleアカウントのメールアドレス（カンマ区切りで複数可）
ALLOWED_GOOGLE_EMAILS=""

# チャットの返答生成に使うClaude APIのキー（1Password: apps/aide-bot/anthropic-api-key）
# 未設定でも画面は開くが、送信するとサーバー側の設定不足として弾かれる
ANTHROPIC_API_KEY=""

# 開発サーバーのポート（省略時は3000）
# PORT=3000
