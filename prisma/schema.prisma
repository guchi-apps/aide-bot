generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// --- 認証 ---
// セッション管理はSupabase Auth側が行うため、Account/Session/VerificationTokenは持たない。
// SupabaseのユーザーID（auth.users.id）を外部キーとして紐付ける。
//
// 会話履歴・連携設定などaide-bot固有のモデルは、機能ごとのIssueでこのUserに紐づけて足す。
model User {
  id             String  @id @default(cuid())
  supabaseUserId String  @unique
  email          String? @unique
  name           String?
  image          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations     Conversation[]
  apiUsages         ApiUsage[]
  mcpConnections    McpConnection[]
  pushSubscriptions PushSubscription[]
  notificationLogs  NotificationLog[]
}

// --- チャット ---
// 相談は話題ごとのスレッドに分ける。対話相手は常に同じ「秘書」1人なので、Conversationは
// 相手の分け目ではなく話題の分け目でしかない（#24）。単一スレッドにしなかったのは、
// 同時に複数の依頼を投げたときに、片方の返答がまだ保存されていない履歴でもう片方が動き、
// 返答が食い違うため。

model Conversation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 最初の発言から自動で付ける。手で付け直す導線は今回は作らない。
  title String @db.VarChar(120)

  createdAt DateTime @default(now())
  // 発言を足しても親のこの列は自動では動かないため、APIハンドラ側で明示的に更新する。
  // 一覧の並び順がここだけを見ているため、動かないと新しい相談が下に沈む。
  updatedAt DateTime @updatedAt

  messages  Message[]
  apiUsages ApiUsage[]

  // 一覧は「自分のもの・更新が新しい順」でしか引かない。
  @@index([userId, updatedAt])
}

enum MessageRole {
  USER
  ASSISTANT
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role        MessageRole
  // 返答はMarkdownで数千字になりうるため、VARCHARではなくTEXTにする。
  content     String      @db.Text
  // 利用者に割り込まれて途中で終わった返答（#48）。次の往復でモデルへ「言い切っていない」
  // ことを伝えるために持つ。本文へ注記を混ぜないのは、保存した文面をそのまま画面へ出すため。
  // USERの発言では常にfalse。
  interrupted Boolean     @default(false)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// --- APIの消費量（#51） ---
// 数える単位は「Messages APIの呼び出し1回」で、秘書の返答（Message）とは別の行に持つ。
//
// **返答の行に持たせると、行が作られない往復のぶんが丸ごと落ちる。** 1文字も出ないうちに
// 割り込まれた往復・生成に失敗した往復では返答を保存しない（route.tsの `answer.trim() !== ""`）が、
// 履歴を毎回まるごと送り直す設計上、入力ぶんはその時点で使い終わっている。
// 1発言に対してAPIを複数回叩く形（ツール利用など）になっても、この単位なら数え方が変わらない。

model ApiUsage {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // どの相談で使ったか。スレッドを消しても使った事実は残したいので、Cascadeではなく
  // SetNullにする（消えるのは紐付けだけ）。
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  // 単価はモデルごとに違う。呼び出したときのモデルが分からないと、CHAT_MODELを変えた時点で
  // 過去ぶんの概算費用まで新しい単価で計算し直されてしまう。
  model String @db.VarChar(64)

  inputTokens      Int
  outputTokens     Int
  // プロンプトキャッシュ（いまは使っていないため常に0。単価が入力と違うので別に持つ）。
  cacheWriteTokens Int @default(0)
  cacheReadTokens  Int @default(0)

  createdAt DateTime @default(now())

  // 画面は「自分のぶんを期間で切る」形でしか引かない。
  @@index([userId, createdAt])
}

// --- 外部サービスとの接続（#46） ---
// 秘書がAIDEやNotionのMCPサーバーを使えるようにするための接続先。1利用者につき複数持てる。
//
// ツールの実行はAnthropic側（Messages APIのMCPコネクタ）が行うため、aide-botが持つのは
// 「どこへ・どの資格情報で繋ぐか」だけ。MCPクライアントの実装もセッションの保持も無い。

model McpConnection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 画面に出す名前。
  label String @db.VarChar(60)
  /// Messages APIへ渡すサーバー名。返答の中で「どのサーバーのツールか」を指す識別子にもなる。
  slug  String @db.VarChar(40)
  /// MCPサーバーのURL（末尾の `/mcp` まで含む）。
  url   String @db.VarChar(500)

  /// 外すと、相談のときにこの接続を渡さなくなる。消さずに一時的に切るための列。
  enabled Boolean @default(true)

  // --- OAuth ---
  // 認可サーバーのエンドポイントは接続したときに一度だけ引き、以後はここを見る。
  // 毎回ディスカバリを回すと、相手が落ちているだけで既存の接続まで使えなくなる。
  authorizationEndpoint String? @db.VarChar(500)
  tokenEndpoint         String? @db.VarChar(500)

  /// 動的クライアント登録（RFC 7591）の結果。公開クライアントなのでsecretは無いことが多い。
  clientId     String? @db.VarChar(255)
  clientSecret String? @db.Text

  // トークンは平文で持つ（#46）。同一VPS・利用者1人という前提と、接続先であるAIDE自身が
  // `data/auth/` に平文で持っていることに合わせた。暗号化するとシークレットが1つ増える。
  accessToken  String?   @db.Text
  refreshToken String?   @db.Text
  /// アクセストークンの期限。この手前で自動的に更新する。
  expiresAt    DateTime?

  // --- 認可の途中（コールバックで消す） ---
  // 認可コードを受け取るまでの間だけ値が入る。残っていても害は無いが、繋ぎ直すたび上書きする。
  pendingState       String? @db.VarChar(64)
  pendingVerifier    String? @db.VarChar(128)
  /// 認可を始めたときのredirect_uri。トークン交換で同じ値を送る必要がある。
  pendingRedirectUri String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 同じ利用者の中でslugは重複させない。Messages APIのサーバー名が衝突するため。
  @@unique([userId, slug])
  // コールバックはstateだけを手掛かりに引く。
  @@index([pendingState])
}

// --- プロアクティブ通知（#79） ---
// 秘書の方から状況を知らせるための購読先と、送った記録。
//
// 配る先はaide-bot自身のWeb Push（#77で決定）。Signalyへ流す案を採らなかったのは、
// 通知を押したときに戻ってくる先がSignalyのPWAになり、そのまま秘書へ返事ができないため。

/**
 * Web Pushの購読先。**端末ごとに1行**になる（iPhone・PCで別々に購読する）。
 *
 * `endpoint` はブラウザベンダーのURLで、数百文字になることがあるためTEXTで持つ。
 * MariaDBは長いTEXTへそのまま一意制約を張れないので、SHA-256の64文字を別の列に持ち、
 * そちらへ張る（guchi-apps/signaly の PushSubscription と同じ手）。
 */
model PushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint String @db.Text
  /// `endpoint` のSHA-256（hex 64文字）。一意制約はこちらに張る。
  endpointHash String @db.VarChar(64)

  /// 購読の鍵（`PushSubscription.getKey()` をbase64urlにしたもの）。
  p256dh String @db.VarChar(255)
  auth   String @db.VarChar(255)

  /// どの端末かを画面で見分けるための覚え書き。User-Agentから機械的に作る。
  deviceLabel String @db.VarChar(120)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// 最後に送信が通った時刻。届かなくなった購読を見分ける手掛かりにする。
  lastNotifiedAt DateTime?

  @@unique([endpointHash])
  @@index([userId, createdAt])
}

/**
 * 送った通知の記録。**これは履歴ではなく抑制のための錠**（#79）。
 *
 * AIDEの `src/worker/notify.ts` が「成功を毎回送ると肝心の失敗が埋もれる」という失敗を
 * 既にしている。同じ理由（kind）・同じ状態（dedupeKey）の通知は一度しか送らない、を
 * DBの一意制約で守る。朝の見通しでは dedupeKey が日本時間の日付になるため、cronが
 * 何度叩かれても1日1本までしか出ない。
 */
model NotificationLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 通知の種類。いまは `morning-briefing` だけ。
  kind String @db.VarChar(40)
  /// 同じ理由の通知を抑制するための鍵。朝の見通しでは `2026-08-26` の形。
  dedupeKey String @db.VarChar(120)

  title String @db.VarChar(120)
  /// 送った本文。空文字は「知らせることが無いと判断して黙った」ことを表す。
  body  String @db.Text

  /// 通知を押したときに開く相談。黙ったときはnull。
  conversationId String? @db.VarChar(191)
  /// 実際に届けられた端末の数。0なら購読が全部落ちていた。
  deliveredCount Int     @default(0)

  createdAt DateTime @default(now())

  @@unique([userId, kind, dedupeKey])
  @@index([userId, createdAt])
}
